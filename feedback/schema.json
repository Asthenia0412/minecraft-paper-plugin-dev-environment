{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["feedback_schema_version", "run_id", "run_kind", "commit", "started_at", "finished_at", "status", "steps", "artifact", "server", "errors"],
  "properties": {
    "feedback_schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "run_kind": {"enum": ["build", "integration"]},
    "commit": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed"]},
    "steps": {"type": "array"},
    "artifact": {"type": ["object", "null"]},
    "server": {"type": ["object", "null"]},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
